    <name>FlashDraws</name>
    <summary>Ferramenta para desenhos gestuais</summary>
    <url type="homepage">https://github.com/luankaike-code/jh-tcc</url>

    <description>
        <p>
            FlashDraws é uma ferramenta feita para facilitar a prática do desenho gestual
        </p>
        <ul>
            <li>Escolha aleatória de referências dentro de uma pasta local</li>
            <li>Quatro modos de sessão (Normal, Aula, Tempo Infinito e Referências Infinitas)</li>
        </ul>
    </description>

    <launchable type="desktop-id">io.github.luankaikecode.flashdraws.desktop</launchable>

